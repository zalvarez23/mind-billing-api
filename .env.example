# App
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# CORS: * = cualquier origen (staging). Prod: https://tu-app.com,http://localhost:5173
CORS_ORIGIN=*

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=mind_billing
DB_PASSWORD=mind_billing_dev
DB_NAME=mind_billing
DB_SYNC=false
DB_LOGGING=true
# Al arrancar la app: migraciones automáticas (default true). Seed en dev (default auto).
DB_MIGRATIONS_RUN=true
DB_SEED_ON_START=auto

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=8h

# Admin (alta de empresas): header X-Admin-Api-Key en POST /v1/admin/companies
# Generar: node -e "console.log('mbak_admin_'+require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=mbak_admin_REPLACE_WITH_RANDOM_HEX

# SUNAT
SUNAT_ENV=beta
SUNAT_BILL_SERVICE_BETA=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_BILL_SERVICE_PROD=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService

# Storage
STORAGE_PATH=./storage

# Firma XML: certificado en tabla certificates (pfx_content bytea + pfx_password).
# Dev: npm run db:seed genera PFX beta en memoria y lo guarda en BD.
# Prod: POST /v1/certificates con el .pfx real del RUC (multipart).
