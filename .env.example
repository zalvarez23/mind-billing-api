# App
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=mind_billing
DB_PASSWORD=mind_billing_dev
DB_NAME=mind_billing
DB_SYNC=false
DB_LOGGING=true
# Al arrancar la app: migraciones automáticas (default true). Seed en dev (default auto).
DB_MIGRATIONS_RUN=true
DB_SEED_ON_START=auto

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=8h

# SUNAT
SUNAT_ENV=beta
SUNAT_BILL_SERVICE_BETA=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_BILL_SERVICE_PROD=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService

# Storage
STORAGE_PATH=./storage

# Firma XML: solo tabla certificates por empresa (pfx_path, pfx_password).
# Dev: npm run db:seed inserta certs/dev-beta.pfx + password en BD para empresa demo.
# Prod: INSERT certificates con el .pfx real del RUC (sin variables de entorno).
